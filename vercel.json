{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/dashboard",  "destination": "/index.html" },
    { "source": "/insights",   "destination": "/index.html" },
    { "source": "/progress",   "destination": "/index.html" }
  ]
}
